{
  "name": "dual-astrology",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "server": "tsx server/index.ts",
    "start": "vite build && tsx server/index.ts",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview",
    "standalone": "node scripts/build-standalone.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "astronomy-engine": "2.1.19",
    "iztro": "2.6.1",
    "lucide-react": "0.460.0",
    "lunar-lite": "0.2.8",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@hono/node-server": "1.13.7",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "hono": "4.6.14",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
