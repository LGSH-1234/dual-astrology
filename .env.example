# mock（默认，无需密钥）或 deepseek
INTERPRETATION_PROVIDER=mock
# 仅在 INTERPRETATION_PROVIDER=deepseek 时需要，只放服务端
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PORT=8787
# 监听地址；默认只允许本机访问，局域网/部署时改为 0.0.0.0
HOST=127.0.0.1
# 账号数据库（SQLite，含密码哈希，勿提交）；以 .json 结尾则用 JSON 文件
DATA_FILE=server/data/dio.sqlite
# 部署在 Nginx/Caddy 等反向代理后面时设为 true（才信任 X-Forwarded-For/Proto）
TRUST_PROXY=false
# 强制 Secure Cookie；不设时 HTTPS 请求自动加 Secure
SECURE_COOKIE=false
# 站点地址，用于生成重置密码链接，例如 https://dio.example.com
APP_URL=
